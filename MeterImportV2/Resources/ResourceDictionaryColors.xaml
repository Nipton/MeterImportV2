<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryColor">BlueViolet</Color>
    <Color x:Key="MouseOverBackground">#B564D4</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="ButtonMouseOverBackground" Color="{StaticResource MouseOverBackground}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#8B008B"/>
    <SolidColorBrush x:Key="BackgroundTextBoxBrush" Color="#E6E6FA"/>
    

    <!--ComboBox-->
    <SolidColorBrush x:Key="TextBox.Static.Background" Color="#FFFFFFFF"/>
    <LinearGradientBrush x:Key="ComboBox.Static.Background" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0.0"/>
        <GradientStop Color="#E0C8EA" Offset="1.0"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ComboBox.Static.Border" Color="#FFACACAC"/>
    <SolidColorBrush x:Key="ComboBox.Static.Glyph" Color="#50026E"/>

    <LinearGradientBrush x:Key="ComboBox.MouseOver.Background" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="{StaticResource MouseOverBackground}" Offset="0.0"/>
        <GradientStop Color="#E0C8EA" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Border" Color="#65247F"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Glyph" Color="#FF000000"/>
    
    <LinearGradientBrush x:Key="ComboBox.Pressed.Background" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="{StaticResource MouseOverBackground}" Offset="0.0"/>
        <GradientStop Color="#E0C8EA" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.Pressed.Border" Color="#65247F"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Glyph" Color="#FF000000"/>

    <SolidColorBrush x:Key="ComboBox.Disabled.Background" Color="#E0C8EA"/>
    <SolidColorBrush x:Key="ComboBox.Disabled.Border" Color="#FFD9D9D9"/>
    <SolidColorBrush x:Key="ComboBox.Disabled.Glyph" Color="#FFBFBFBF"/>

    <LinearGradientBrush x:Key="ComboBoxItem.MouseOver.Background" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#996ca9" Offset="0.0"/>
        <GradientStop Color="#ac88b9" Offset="1.0"/>
    </LinearGradientBrush>
    <!--ComboBox-->
</ResourceDictionary>